<section class="ui left aligned middle aligned segment">
  
  <h2>Movie App Dashboard</h2>
  
  {{#unless movies}}
    <h3 class="ui message">
      Start adding your movies!
    </h3>
  {{/unless}}
  {{#each movies}}
    <section class="ui left aligned middle aligned segment">
      <h3 class="ui header">
        {{uppercase title}}
      </h3>
      
     <p>
    <i class="film icon"></i>
    {{#if movies}}
        Total movies:
        {{movies.length}}
    {{else}}
        Empty collection!
    {{/if}}
    {{#if date}}
        <br>
        <i class="calendar alternate outline icon"></i>
        Created on <i>{{formatDate date}}</i>
    {{/if}}
     </p>

    {{#if rating}}
    <p>
        <span 
            class="ui yellow disabled rating" 
            data-icon="star" 
            data-rating="{{rating}}" 
            data-max-rating="5">
        </span>

        <span style="color: grey; font-size: 90%; font-style: italic">
              {{highlightPopular rating}}
        </span>
    </p>
    {{/if}}

	  <a href="/movie/{{id}}">
	     <i class = "eye icon"></i>
	  </a>
    <a href="/dashboard/deletecollection/{{id}}">
   <i class="ui trash black icon"></i>
    </a> 

    </section>
  {{/each}}
</section>