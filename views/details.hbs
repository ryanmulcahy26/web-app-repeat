{{> menu id="details"}}

<section class="ui center aligned middle aligned segment">
  <h2>Movie App Details</h2>

  <h3 class="ui header">
    The movie app now contains:
  </h3>

  {{#with stats}}

  <div class="ui center aligned grid">

    <div class="ui sixteen wide column">
      <div class="ui centered four statistics">

        <div class="ui statistic">
          <div class="value">
            <i class="users icon"></i>
          </div>
          <div class="label">
            {{displayNumUsers}} users signed up
          </div>
        </div>

        <div class="ui statistic">
          <div class="value">
            <i class="folder open icon"></i>
          </div>
          <div class="label">
            {{displayNumCollections}} collections
          </div>
        </div>

        <div class="ui statistic">
          <div class="value">
            <i class="film icon"></i>
          </div>
          <div class="label">
            {{displayNumMovies}} movies
          </div>
        </div>

        <div class="ui statistic">
          <div class="value">
            <i class="balance scale icon"></i>
          </div>
          <div class="label">
            Average movies per <br>
            collection: {{displayAverage}}
          </div>
        </div>

      </div>
    </div>

    <div class="ui sixteen wide column">
      <div class="ui centered three statistics">

        <div class="ui statistic">
          <div class="value">
            <i class="star icon"></i>
          </div>

          <div class="label">
            Highest Rated Collections: {{highest}} stars

            <table class="ui centered table">
              {{#each displayFav}}
              <tr>
                <td>{{this}}</td>
              </tr>
              {{/each}}
            </table>
          </div>
        </div>

        <div class="ui statistic">
          <div class="value">
            <i class="dot circle outline icon"></i>
          </div>

          <div class="label">
            Average Rating: {{displayAvgRating}}
          </div>
        </div>

        <div class="ui statistic">
          <div class="value">
            <i class="plus icon"></i>
          </div>

          <div class="label">
            Largest Collection: {{longest}} movies

            <table class="ui centered table">
              {{#each longestTitles}}
              <tr>
                <td>{{this}}</td>
              </tr>
              {{/each}}
            </table>
          </div>
        </div>

      </div>
    </div>

  </div>

  {{/with}}
</section>