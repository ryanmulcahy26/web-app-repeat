{{> menu}}

<section class="ui center aligned middle aligned segment">
  <h2>Welcome to Ryan's Movie App</h2>
    <p>
      This app will allow users to create and maintain a list of their favorite movies.
    </p>

      <div class="ui five statistics" style="margin-top: 1em;">
    
    <div class="statistic">
      <div class="value">
        <i class="film icon"></i> 
      </div>
      <div class="label">
        App Title: <br>
        {{info.appTitle}}
      </div>
    </div>
    
   <div class="statistic">
      <div class="value">
        <i class="code branch icon"></i> 
      </div>
      <div class="label">
        App Version: <br>
        Version {{info.version}}
      </div>
    </div>    
    <div class="statistic">
      <div class="value">
        <i class="map pin icon"></i> 
      </div>
      <div class="label">
        Made in: <br>
        {{info.location}}
      </div>
    </div>    
    <div class="statistic">
      <div class="value">
        <i class="user icon"></i> 
      </div>
      <div class="label">
        Created by: Ryan Mulcahy<br>
        {{info.creators.0.name}}
      </div>
    </div> 
    </div> 
  </div>
</section>
