{{> menu}}

<section class="ui center aligned middle aligned segment">
  <h2>Welcome to Ryan's Movie App</h2>
    <p>
      This app will allow users to create and maintain a list of their favorite movies.
    </p>
    <img src="/start-poster-movie.jpg" alt="Movie App Poster" class="ui centered image">

      <div class="ui five statistics" style="margin-top: 1em;">
    
  {{#with info}}

<div class="statistic">
  <div class="value">
    <i class="film icon"></i> 
  </div>
  <div class="label">
    App Title: <br>
    {{appTitle}}
  </div>
</div>

<div class="statistic">
  <div class="value">
    <i class="code branch icon"></i> 
  </div>
  <div class="label">
    App Version: <br>
    Version {{version}}
  </div>
</div>

<div class="statistic">
  <div class="value">
    <i class="map pin icon"></i> 
  </div>
  <div class="label">
    Made in: <br>
    {{location}}
  </div>
</div>

<div class="statistic">
  <div class="value">
    <i class="user icon"></i> 
  </div>
  <div class="label">
    Created by: <br>
    {{creators.0.name}}
  </div>
</div>

<div class="statistic">
  <div class="value">
    <i class="retweet icon"></i> 
  </div>
  <div class="label">
    Share with Friends!: <br>
    {{share}}
  </div>
</div>
{{/with}}

</div>
</section>
